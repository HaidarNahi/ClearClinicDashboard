# Copy these into Netlify → Site configuration → Environment variables.
# Never commit a filled-in version of this file.

# The entire service-account JSON from Firebase, pasted as ONE line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Realtime Database URL (Firebase console → Realtime Database)
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.REGION.firebasedatabase.app

# Web API key (Project settings → General). Public by design.
FIREBASE_API_KEY=AIza...

# Project id (Project settings → General)
FIREBASE_PROJECT_ID=your-project-id
