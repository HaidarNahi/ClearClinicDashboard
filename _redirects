# Netlify serves /.netlify/* (Identity + Functions) natively and forces HTTPS
# on its own, so no rules are needed for either. A self-referential
# /.netlify/* rule and a :host placeholder are both rejected as invalid.

# Friendly alias for the session endpoint
/api/session   /.netlify/functions/session   200

# SPA fallback — everything else serves the shell (hash routing)
/*             /index.html                   200
